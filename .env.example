# EverAfter API — environment variables
# Copy this file to .env and fill in the values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=5000

# Database (required in production; development falls back to mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB=everafter

# Client origin(s) used for CORS and Stripe redirect URLs.
# Comma-separated for extra origins (e.g. a Vercel preview domain).
CLIENT_URL=http://localhost:3000

# Better Auth JWT bridge (managed in the client app)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_JWT_ISSUER=
BETTER_AUTH_JWT_AUDIENCE=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_CENTS=4900
PREMIUM_CURRENCY=usd
PREMIUM_DURATION_DAYS=30

# ImgBB image hosting
IMGBB_API_KEY=
